# ===================================================================
# SUDOKU MASTER AI - ENVIRONMENT TEMPLATE (.env.example)
# Developed by Gandham Bhanu Prakash
# ===================================================================

# SERVER CONFIGURATION
PORT=8085
SPRING_APPLICATION_NAME=sudoku-master-backend

# DATABASE CONFIGURATION
SPRING_DATASOURCE_URL=jdbc:h2:mem:sudokudb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=password

# JWT AUTHENTICATION SECRET & EXPIRATION
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_EXPIRATION_MS=86400000

# SMTP MAIL CONFIGURATION (SUPPORT & FEEDBACK FORM)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_gmail_address@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true

# FRONTEND API CONFIGURATION
VITE_API_BASE_URL=http://localhost:8085/api
VITE_APP_TITLE=Sudoku Master AI
VITE_DEVELOPER_NAME=Gandham Bhanu Prakash
